---
import { ratingLabels } from '../lib/data';

interface Props { rating?: number | null; showEmpty?: boolean }
const { rating, showEmpty = false } = Astro.props;
const label = rating ? `${rating} of 3 hearts: ${ratingLabels[rating]}` : '';
---
{rating ? (
  <span class="hearts" role="img" aria-label={label} title={ratingLabels[rating]}>
    {'♥'.repeat(rating)}{showEmpty && <span class="off">{'♥'.repeat(3 - rating)}</span>}
  </span>
) : null}
