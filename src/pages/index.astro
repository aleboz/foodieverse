---
import Base from '../layouts/Base.astro';
import { cities, recentPois, citySlug } from '../lib/data';
import { cityHref, poiHref } from '../lib/url';
---
<Base title="Irina's Foodieverse">
  <div class="home">
    <h1 class="home-title"><span>Irina's Foodieverse</span></h1>
    <p class="home-tagline">Places I think are worth your time.</p>

    <div class="home-intro">
      <p>This is Irina’s little guide to the cities I have visited. I believe that food and drinks are the most important ways to experience a city. Everything else can be seen and experienced as a way to work up an appetite of course!</p>
      <p>The list is in progress and constantly updated. I started just this recently so it is still a bit thin in places :) I have my own preferences and biases, so use at your own risk!</p>
      <p>Note - I do not drink coffee, I am a tea nerd instead. So any notes about coffee below aren’t based on my own experience, but reports of others :)</p>
      <p>There are no Michelin-starred restaurants on the list below. These cities have many many of those and all of them offer amazing experiences. The list below though is less experience and more just excellent food.</p>
    </div>

    <a class="continue" id="continue" href="#" hidden>
      <span>Continue with <span data-city-name></span></span>
      <span aria-hidden="true">→</span>
    </a>

    {cities.length ? (
      <nav aria-label="Cities">
        <ul class="city-list">
          {cities.map((c) => (
            <li>
              <a class="city-link" href={cityHref(c.slug)} data-city={c.slug}>
                <span class="name">{c.name}</span>
                <span class="sub">{c.count} {c.count === 1 ? 'place' : 'places'}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <p class="empty">No recommendations yet — check back soon.</p>
    )}

    {recentPois.length > 0 && (
      <section aria-labelledby="recent-title">
        <h2 class="section-title" id="recent-title">Recently added</h2>
        <ul class="recent">
          {recentPois.map((p) => (
            <li>
              <a href={poiHref(citySlug(p), p.slug)}>
                <span>{p.name}</span>
                <span class="where">{p.city}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="site-footer">
      <p>Personal recommendations from Irina to her friends — not reviews, not ads.</p>
    </footer>
  </div>
</Base>

<script>
  // Offer the last city viewed (stored only in this browser).
  try {
    const last = JSON.parse(localStorage.getItem('foodieverse:lastCity') ?? 'null');
    const link = document.querySelector<HTMLAnchorElement>(`.city-link[data-city="${CSS.escape(last?.slug ?? '')}"]`);
    const cont = document.getElementById('continue') as HTMLAnchorElement | null;
    if (last && link && cont) {
      cont.href = link.href;
      cont.querySelector('[data-city-name]')!.textContent = last.name;
      cont.hidden = false;
    }
  } catch {
    /* storage unavailable */
  }
</script>
