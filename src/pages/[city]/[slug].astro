---
import Base from '../../layouts/Base.astro';
import { allPois, activePois, citySlug, vibeLabel, servesLabels, imagesFor, googleMapsHref } from '../../lib/data';
import { cityHref, poiHref, asset } from '../../lib/url';

export function getStaticPaths() {
  // Closed POIs keep their page so shared links still work; archived ones do not.
  return allPois.map((p) => ({ params: { city: citySlug(p), slug: p.slug }, props: { poi: p } }));
}

const { poi } = Astro.props;
const cSlug = citySlug(poi);
const images = imagesFor(poi);
const paragraphs = poi.recommendation.split(/\n{2,}/);
const statusNote = {
  'temporarily-closed': 'Temporarily closed — check before you go.',
  closed: 'This place has closed. Kept here for the memories.',
} as Record<string, string>;
const nearby = activePois
  .filter((p) => citySlug(p) === cSlug && p.id !== poi.id)
  .slice(0, 3);
const srcset = (img: (typeof images)[number]) => img.variants.map((v) => `${asset(v.path)} ${v.w}w`).join(', ');
const pick = (img: (typeof images)[number], w: number) => (img.variants.find((v) => v.w >= w) ?? img.variants.at(-1)!).path;
const ogImage = images[0] ? asset(pick(images[0], 960)) : undefined;
const mapData = { lat: poi.location.latitude, lng: poi.location.longitude, name: poi.name };
const added = new Date(poi.createdAt + 'T00:00:00Z').toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base
  title={`${poi.name} · ${poi.city}`}
  description={poi.recommendation.slice(0, 200)}
  image={ogImage}
  back={{ href: cityHref(cSlug), label: poi.city }}
>
  <article class="poi" data-city={cSlug}>
    <h1 class="poi-name"><span>{poi.name}</span></h1>
    <div class="poi-meta">
      <span class="vibe">{vibeLabel(poi.vibe)}</span>
      <span class="meta">{servesLabels(poi).join(' · ')}</span>
      <span class="meta">{poi.city}{poi.country ? `, ${poi.country}` : ''}</span>
    </div>
    {poi.tags && poi.tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {poi.tags.map((t) => <li><a href={`${cityHref(cSlug)}?tag=${encodeURIComponent(t)}`}>{t}</a></li>)}
      </ul>
    )}
    {statusNote[poi.status] && <p class="status-note" role="note">{statusNote[poi.status]}</p>}

    <blockquote class="recommendation">
      {paragraphs.map((para) => <p>{para}</p>)}
    </blockquote>
    <p class="byline">— Irina's personal recommendation · added {added}</p>

    {images.length > 0 && (
      <ul class="gallery" aria-label="Photos">
        {images.map((img, i) => (
          <li>
            <img
              src={asset(pick(img, 960))}
              srcset={srcset(img)}
              sizes={images.length === 1 ? '(min-width: 720px) 688px, 100vw' : '(min-width: 720px) 560px, 85vw'}
              width={img.width}
              height={img.height}
              alt={poi.imageAlt?.[i] || `Photo ${i + 1} of ${poi.name}`}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </li>
        ))}
      </ul>
    )}

    {poi.address && <p class="poi-address">📍 {poi.address}</p>}
    <div class="mini-map" id="mini-map" role="img" aria-label={`Map showing the location of ${poi.name}`}></div>

    <div class="poi-actions poi-cta">
      <a class="btn btn-primary" href={googleMapsHref(poi)} target="_blank" rel="noopener">
        Open in Google Maps <span aria-hidden="true">↗</span>
      </a>
      <button type="button" class="btn" id="share" hidden>Share</button>
    </div>

    {nearby.length > 0 && (
      <section class="more-in-city" aria-labelledby="more-title">
        <h2 class="section-title" id="more-title">More in {poi.city}</h2>
        <ul class="recent">
          {nearby.map((p) => (
            <li><a href={poiHref(cSlug, p.slug)}><span>{p.name}</span><span class="where">{vibeLabel(p.vibe)}</span></a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
  <script type="application/json" id="poi-data" set:html={JSON.stringify(mapData).replace(/</g, '\\u003c')} />
</Base>

<script>
  const article = document.querySelector<HTMLElement>('.poi')!;
  const city = article.dataset.city!;

  // Back link returns to the city with the filters that were active.
  try {
    const saved = sessionStorage.getItem(`foodieverse:cityUrl:${city}`);
    const back = document.querySelector<HTMLAnchorElement>('.site-header .back');
    if (saved && back && saved.startsWith(new URL(back.href).pathname)) back.href = saved;
  } catch {
    /* storage unavailable */
  }

  // Share via the native sheet where available (progressive enhancement).
  const share = document.getElementById('share')!;
  if (navigator.share) {
    share.hidden = false;
    share.addEventListener('click', () => {
      navigator.share({ title: document.title, url: location.href }).catch(() => {});
    });
  }

  // Mini map: load Leaflet only when the map scrolls into view.
  const el = document.getElementById('mini-map')!;
  const data = JSON.parse(document.getElementById('poi-data')!.textContent!);
  const io = new IntersectionObserver(
    async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const { createMap } = await import('../../scripts/map');
      await createMap(el, [{ id: 'poi', name: data.name, lat: data.lat, lng: data.lng, meta: '', url: '' }], {
        zoom: 15,
        interactive: false,
      });
    },
    { rootMargin: '200px' },
  );
  io.observe(el);
</script>
